.env
data/
# index/ is tracked as an empty directory so the compose bind mount does not
# create it as root, which would stop the extractor writing into it.
index/*
!index/.gitkeep
embedding_model/*
!embedding_model/.ignore
.DS_Store
all_code_blocks.json
__pycache__/
*.pyc
.pytest_cache/
# Cached embedding vectors, keyed by text and model. Rebuildable, and large.
.cache/
# The web image installs its own; a local install is only for typechecking
# and editor tooling.
node_modules/
web/tsconfig.tsbuildinfo

# Eval runs. The headline numbers get written into
# docs/graph-rag-plan.md when a phase lands; the raw retrieval behind
# them is large and reproducible from the dataset.
eval/snapshots/

.env.local

# Host virtualenv for running the eval outside the containers.
.venv/
