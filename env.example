#*****************************************************************
# LLM and Embedding Model
#*****************************************************************
LLM=qwen2.5-coder:1.5b #or any Ollama model tag, gpt-4, gpt-3.5, or claude
EMBEDDING_MODEL=sentence_transformer #or openai, ollama, or aws

#*****************************************************************
# Neo4j
#*****************************************************************
#NEO4J_URI=neo4j://database:7687
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=password

#*****************************************************************
# Code index
#*****************************************************************
# Symbols embedded and written to Neo4j per batch when importing.

#IMPORT_BATCH_SIZE=100

# Vectors are cached on disk by the text and model that produced them, so
# re-importing a repository only pays for the symbols that actually changed.
# Set to 0 to always call the embedding model.
#EMBEDDING_CACHE=1
#EMBEDDING_CACHE_PATH=.cache/embeddings.sqlite

#*****************************************************************
# API
#*****************************************************************
# Leave API_KEY empty for local development. When set, the API requires it in
# the X-API-Key header (or as an api_key query parameter on /query-stream,
# because EventSource cannot send headers).

#API_KEY=
#ALLOWED_ORIGINS=http://localhost:5173
#RATE_LIMIT_REQUESTS=30
#RATE_LIMIT_WINDOW_SECONDS=60
#VITE_API_BASE_URL=http://localhost:8504

#*****************************************************************
# Langchain
#*****************************************************************
# Optional for enabling Langchain Smith API

#LANGCHAIN_TRACING_V2=true # false
#LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
#LANGCHAIN_PROJECT=#your-project-name
#LANGCHAIN_API_KEY=#your-api-key ls_...

#*****************************************************************
# Ollama
#*****************************************************************
# The default expects Ollama running on the host. To run it as a container
# instead, uncomment both lines below - COMPOSE_PROFILES is what makes plain
# `docker compose up` start the llm service, and without it the hostname in
# OLLAMA_BASE_URL does not resolve.

#COMPOSE_PROFILES=linux
#OLLAMA_BASE_URL=http://llm:11434

#OLLAMA_BASE_URL=http://host.docker.internal:11434

#*****************************************************************
# OpenAI
#*****************************************************************
# Only required when using OpenAI LLM or embedding model

#OPENAI_API_KEY=sk-...

#*****************************************************************
# AWS
#*****************************************************************
# Only required when using AWS Bedrock LLM or embedding model

#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-east-1

#*****************************************************************
# Repository cloning
#*****************************************************************
# Hosts the loader is allowed to clone from. Add a self-hosted GitHub/GitLab
# here if you need one.

#ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
